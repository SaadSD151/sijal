{
  "rules": {
    "lb": {
      ".read": true,
      ".indexOn": [
        "w",
        "h"
      ],
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists() || (auth.uid === 'iEZ50WCKXcXKddkd2kPMdZ65QxM2' || auth.token.email === 'saadsd@players.sijal.game'))",
        ".validate": "newData.hasChildren(['n','w','h']) && newData.child('n').isString() && newData.child('n').val().length <= 18 && newData.child('w').isNumber() && newData.child('w').val() >= 0 && newData.child('h').isNumber() && newData.child('h').val() >= 0"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "names": {
      ".read": "auth != null && (auth.uid === 'iEZ50WCKXcXKddkd2kPMdZ65QxM2' || auth.token.email === 'saadsd@players.sijal.game')",
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "admins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.uid === 'iEZ50WCKXcXKddkd2kPMdZ65QxM2' || auth.token.email === 'saadsd@players.sijal.game'))",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === 'iEZ50WCKXcXKddkd2kPMdZ65QxM2' || auth.token.email === 'saadsd@players.sijal.game')"
      }
    },
    "msg": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.uid === 'iEZ50WCKXcXKddkd2kPMdZ65QxM2' || auth.token.email === 'saadsd@players.sijal.game'))"
    },
    "grants": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === 'iEZ50WCKXcXKddkd2kPMdZ65QxM2' || auth.token.email === 'saadsd@players.sijal.game')"
      }
    },
    "stats": {
      ".read": "auth != null && (auth.uid === 'iEZ50WCKXcXKddkd2kPMdZ65QxM2' || auth.token.email === 'saadsd@players.sijal.game')",
      "d": {
        "$day": {
          "$k": {
            ".write": "$day.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && $k.matches(/^[a-z0-9_]+$/) && $k.length <= 12",
            ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 100000"
          }
        }
      },
      "t": {
        "$k": {
          ".write": "$k.matches(/^[a-z0-9_]+$/) && $k.length <= 12",
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 100000"
        }
      },
      "on": {
        ".write": "auth != null && (auth.uid === 'iEZ50WCKXcXKddkd2kPMdZ65QxM2' || auth.token.email === 'saadsd@players.sijal.game')",
        "$id": {
          ".write": "$id.matches(/^[a-z0-9]+$/) && $id.length >= 8 && $id.length <= 16",
          ".validate": "newData.hasChildren(['t','s']) && newData.child('t').isNumber() && newData.child('t').val() <= now"
        }
      }
    },
    "bw": {
      ".read": true,
      "$k": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.uid === 'iEZ50WCKXcXKddkd2kPMdZ65QxM2' || auth.token.email === 'saadsd@players.sijal.game'))",
        ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 2 && newData.val().length <= 30)"
      }
    },
    "polls": {
      ".read": "auth != null && (auth.uid === 'iEZ50WCKXcXKddkd2kPMdZ65QxM2' || auth.token.email === 'saadsd@players.sijal.game')",
      "$pid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && now < 1796018400000",
          ".validate": "newData.isString() && newData.val().matches(/^[abc]$/)"
        }
      }
    },
    "daily": {
      ".read": true,
      "$day": {
        ".indexOn": [
          "t"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $day.matches(/^20[0-9][0-9][01][0-9][0-3][0-9]$/)",
          ".validate": "newData.hasChildren(['n','t']) && newData.child('n').isString() && newData.child('n').val().length <= 18 && newData.child('t').isNumber() && newData.child('t').val() >= 300 && (!data.exists() || newData.child('t').val() < data.child('t').val())"
        }
      }
    }
  }
}
