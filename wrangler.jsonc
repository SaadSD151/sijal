// Cloudflare Workers: serves the ready-built game (dist/site) on sijalwar.com,
// and runs worker/index.js for /api/* (the automatic Season Zero pass after a PayPal payment)
{
  "name": "sijal",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  // keep the variables set in the Cloudflare dashboard on every deploy
  "keep_vars": true,
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
